<!--
  pfSense firewall detection rules for Wazuh
  ===================================================================
  Deploy to : /var/ossec/etc/rules/pfsense_custom_rules.xml
  Ownership : sudo chown wazuh:wazuh <file>
              sudo chmod 660 <file>
  Validate  : sudo /var/ossec/bin/wazuh-analysisd -t     << BEFORE restarting
  Reload    : sudo systemctl restart wazuh-manager
  Test      : sudo /var/ossec/bin/wazuh-logtest          << paste a sample line

  Requires  : detections/pfsense_custom_decoders.xml

  NUMBERING
  _________
  Custom identifiers start at 100000 so they never collide with the shipped
  ruleset. These are numbered from 100900 to leave 100003 - written for an
  earlier application log detection in the same environment - untouched.

  ATTRIBUTION NOTE
  ________________
  These messages arrive over the system logging protocol with no agent
  behind them, so alerts are recorded against the MANAGER, not against the
  machine that generated the traffic. Filtering a dashboard by the
  endpoint's agent name returns nothing at all. Filter on rule.groups or on
  data.srcip instead; both are populated on every one of these alerts.

  KNOWN LIMITATION (documented rather than hidden)
  ________________________________________________
  Rule 100901 is effectively dead. The obvious discriminator - the decoded
  'action' field - is a RESERVED STATIC FIELD in the rule language and the
  manager refuses to start if it is used as a general field test:

      wazuh-analysisd: ERROR: Failure to read rule 100900.
                       Field 'action' is static.

  With that condition removed from both rules, 100900 and 100901 have
  identical matching conditions and the more specific of two equal rules
  wins consistently, so permitted traffic is not separately alerted on.
  A real fix needs a discriminator that is not the reserved name, such as
  matching on decoded direction or a tighter child decoder that only ever
  claims denials.
-->

<group name="pfsense,pfsense_custom,">

  <!-- Every decoded firewall message. Level 5: worth recording, not worth
       waking anyone up for. -->
  <rule id="100900" level="5">
    <decoded_as>pfsense-filterlog</decoded_as>
    <description>pfSense: packet blocked from $(srcip) to $(dstip) over $(protocol).</description>
    <group>firewall_block,</group>
  </rule>

  <!-- Permitted traffic, lower severity because it is context rather than
       an incident. See the limitation note above: this rule does not fire
       in the delivered build. -->
  <rule id="100901" level="3">
    <decoded_as>pfsense-filterlog</decoded_as>
    <description>pfSense: packet permitted from $(srcip) to $(dstip).</description>
    <group>firewall_pass,</group>
  </rule>

  <!-- Correlation. One blocked packet is noise; repeated blocked packets
       from one source inside a minute is a pattern, and describing the
       pattern once is more useful than describing each packet eight times.
       <same_source_ip /> groups the count by source so unrelated activity
       from different machines does not accumulate into a pattern that was
       never there.

       Observed behaviour: a burst of 16 requests to a blocked address
       produced 14 alerts at 100900 and 2 at 100902 in the same window.
       The literal frequency value below is not claimed as the exact
       firing point. -->
  <rule id="100902" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100900</if_matched_sid>
    <same_source_ip />
    <description>pfSense: repeated blocked packets from $(srcip) within one minute.</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>firewall_block,recon,</group>
  </rule>

</group>
