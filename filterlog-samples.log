# Sample pfSense filterlog messages, exactly as received by the manager.
#
# Paste a single line (without the leading # of a comment) into wazuh-logtest
# to exercise the decoder and rules without a firewall attached:
#
#     sudo /var/ossec/bin/wazuh-logtest
#
# Note what is NOT here: there is no hostname between the timestamp and
# "filterlog[...]". That absence is the whole reason the shipped decoder
# cannot match these messages. See docs/ for the full explanation.
#
# Expected result for either line below:
#     Phase 1  timestamp read, hostname recorded as 'filterlog[...]:'
#     Phase 2  decoder 'pfsense-filterlog', fields extracted
#     Phase 3  rule 100900, level 5, alert to be generated


# --- ICMP denial, no ports (endpoint to a blocked address) ---
Aug 29 20:03:55 filterlog[52302]: 75,,,1787924727,em1,match,block,in,4,0x0,,64,33338,0,DF,1,icmp,84,192.168.10.100,142.251.153.4,request,10567,264

# --- ICMP denial, second sample from a different burst ---
Aug 29 12:22:52 filterlog[84779]: 75,,,1787924727,em1,match,block,in,4,0x0,,64,13436,0,DF,1,icmp,84,192.168.10.100,142.251.153.4,request,52863,164


# ===================================================================
# Reference: decoded output for the first line
# ===================================================================
#
# **Phase 2: Completed decoding.
#         name: 'pfsense-filterlog'
#         action: 'block'
#         direction: 'in'
#         dstip: '142.251.153.4'
#         dstport: '10567'
#         interface: ',,1787924727,em1'
#         protocol: 'icmp'
#         srcip: '192.168.10.100'
#         srcport: 'request'
#
# **Phase 3: Completed filtering (rules).
#         id: '100900'
#         level: '5'
#         description: 'pfSense: packet blocked from 192.168.10.100
#                       to 142.251.153.4 over icmp.'
#         groups: '['pfsense', 'pfsense_custom', 'firewall_block']'
# **Alert to be generated.
#
# The 'interface' and 'srcport' values above are the two known decoder
# imperfections, documented in detections/pfsense_custom_decoders.xml.
# Every field the rules act on is correct.
#
#
# ===================================================================
# Reference: decoded output for a denial that DOES carry ports (TCP)
# ===================================================================
#
# **Phase 2: Completed decoding.
#         name: 'pfsense-filterlog'
#         action: 'block'
#         direction: 'in'
#         dstip: '184.51.192.19'
#         dstport: '80'
#         protocol: 'tcp'
#         srcip: '192.168.10.100'
#         srcport: '58556'
